# Installed by `make install`, which also enables it unless DESTDIR is set.
#
# Hardened on the assumption that the config, the TLS material and the scripts
# are all read-only. What a script keeps between requests lives in memory.
[Unit]
Description=Programmable Redfish proxy
Documentation=https://github.com/s3rj1k/programmable-redfish-proxy
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/programmable-redfish-proxy --config-path /etc/programmable-redfish-proxy/config.toml
# SIGHUP recompiles the scripts in place. A script that fails to compile leaves
# the running set alone, and what a script has kept survives either way.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/programmable-redfish-proxy

[Install]
WantedBy=multi-user.target
