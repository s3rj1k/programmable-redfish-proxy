// `Systems/{id}/Bios/Actions/Bios.ChangePassword`, the UEFI setup password. The
// emulator has no route for it under either spelling, so it is answered here.

// The value is not kept. Nothing can verify a UEFI password against an emulated
// machine, so only the fact that one was set is remembered.
pub async fn handle(req) {
    log::request("info", false)?;

    let named = false;
    let given = false;
    if req.is_json() {
        let body = req.json()?;
        match util::at(body, "PasswordName")? {
            Some(_) => { named = true; }
            None => {}
        }
        match util::at(body, "NewPassword")? {
            Some(_) => { given = true; }
            None => {}
        }
    }
    if !named || !given {
        return resp::json(400, #{
            "error": #{
                "code": "Base.1.0.GeneralError",
                "message": "PasswordName and NewPassword are both required",
            },
        }).log("info", true)?;
    }

    store::set("supermicro/UefiPasswordSet", true)?;
    resp::status(204).log("info", true)
}
