// `Managers/{id}/EthernetInterfaces`. Synthesised outright, since the emulator
// has no manager NIC and the MAC here is what a machine is registered under.

pub async fn handle(req) {
    log::request("info", false)?;

    let base = req.path;
    resp::json(200, #{
        "@odata.id": base,
        "@odata.type": "#EthernetInterfaceCollection.EthernetInterfaceCollection",
        "Name": "Ethernet Interface Collection",
        "Members": [ #{ "@odata.id": `${base}/eth0` } ],
        "Members@odata.count": 1,
    }).rewrite()?.log("info", true)
}
